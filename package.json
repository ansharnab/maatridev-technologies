{
  "name": "maatridev-technologies",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "free-port": "node scripts/free-port.mjs 3001",
    "predev": "node scripts/free-port.mjs 3001",
    "dev": "concurrently \"npm run dev:client\" \"npm run dev:server\"",
    "dev:client": "vite",
    "dev:server": "node server/index.js",
    "build": "node scripts/generate-sitemap.mjs && vite build",
    "preview": "vite preview",
    "start": "node server/index.js",
    "production": "npm run build && npm start",
    "push-live-content": "node scripts/push-live-content.js",
    "blog:generate": "node scripts/generate-daily-blog.mjs",
    "seo:sitemap": "node scripts/generate-sitemap.mjs",
    "seo:audit": "node scripts/seo/health-audit.mjs",
    "seo:daily": "node scripts/seo-daily.mjs --seo-only",
    "seo:daily:full": "node scripts/seo-daily.mjs --with-blog",
    "seo:weekly": "node -e \"import('./scripts/seo/weekly-report.mjs').then(m=>m.generateWeeklyReport())\"",
    "seo:ping": "node -e \"import('./scripts/seo/ping-discovery.mjs').then(m=>m.pingDiscovery())\"",
    "seo:pagespeed": "node -e \"import('./scripts/seo/pagespeed.mjs').then(m=>m.runPageSpeedAudit())\"",
    "seo:publish": "node -e \"import('./scripts/seo/sync-web-root.mjs').then(m=>m.syncWebRoot())\"",
    "seo:email-test": "node scripts/seo/test-social-email.mjs",
    "test:header": "node scripts/test-header-theme.mjs",
    "test:header:mobile": "node scripts/test-mobile-header-css.mjs",
    "test:nav": "node scripts/test-nav-structure.mjs",
    "test:nav:browser": "node scripts/test-mobile-home-menu.mjs",
    "test:admin": "node scripts/test-admin-panel.mjs"
  },
  "dependencies": {
    "@hello-pangea/dnd": "^18.0.1",
    "@measured/puck": "^0.20.2",
    "axios": "^1.9.0",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "multer": "^1.4.5-lts.2",
    "nodemailer": "^6.10.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-grid-layout": "^1.5.1",
    "react-helmet-async": "^3.0.0",
    "react-router-dom": "^7.6.0",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.4.1",
    "concurrently": "^9.1.2",
    "playwright": "^1.60.0",
    "vite": "^6.3.5"
  }
}
