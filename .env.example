# Copy to .env and fill in your values:
#   cp .env.example .env        (Mac/Linux)
#   copy .env.example .env      (Windows)

# --- App / API (server + local dev) ---
ADMIN_PASSWORD=change-me-to-a-strong-password
PORT=3001

# Vite dev server proxies /api and /uploads to this URL
VITE_DEV_API_URL=http://localhost:3001

# Canonical URL for SEO (title, OG, sitemap) — must match live domain
VITE_SITE_URL=https://maatridev.com

# --- Daily auto-blog (server only — never commit real key) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Optional — relevant hero photos (free): https://unsplash.com/developers
UNSPLASH_ACCESS_KEY=
# Optional backup image API: https://www.pexels.com/api/
PEXELS_API_KEY=
# Unified daily cron (blog + SEO) — deploy/install-daily-automation.sh
DAILY_CRON_SCHEDULE=0 6 * * *
DAILY_CRON_LOG=/home/ec2-user/maatridev-daily.log

# --- SEO automation (server) ---
# Static publish after blog (needs: bash deploy/setup-publish-sudo.sh once on EC2)
SEO_PUBLISH_WEB_ROOT=/var/www/maatridev
# Generate once: openssl rand -hex 16 — also creates public/{key}.txt on first run
INDEXNOW_KEY=
# PageSpeed Insights API key (Google Cloud Console → enable PageSpeed API)
GOOGLE_PSI_API_KEY=
# Google Analytics 4 (build-time for Vite — set before npm run build)
VITE_GA_MEASUREMENT_ID=

# --- Live / production URLs ---
# Public site (browser). Use https://your-domain.com after SSL setup.
LIVE_URL=https://maatridev.com
PUBLIC_URL=https://maatridev.com

# --- SSL (deploy/ssl-setup.sh on EC2) ---
SSL_DOMAIN=maatridev.com
SSL_EMAIL=hello@maatridev.com

# --- EC2 deploy (deploy/ec2-push.sh) ---
DEPLOY_SSH_USER=ec2-user
# Hostname or IP (no ssh:// prefix)
DEPLOY_SSH_HOST=ec2-XX-XX-XX-XX.ap-south-1.compute.amazonaws.com
# Path to your .pem key (supports ~)
DEPLOY_SSH_KEY=~/Downloads/your-key.pem
DEPLOY_REMOTE_APP_PATH=/home/ec2-user/maatridev-technologies
